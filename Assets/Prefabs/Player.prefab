    bulletCore: 1
  - type: 26
    rarity: 0
    title: MINE
    tag: "BULLET \xB7 END"
    description: Bullets stopping on walls may leave a mine (15 damage blast).
    titleVi: "M\xCCN"
    tagVi: "\u0110\u1EA0N \xB7 K\u1EBET TH\xDAC"
    descriptionVi: "\u0110\u1EA1n d\u1EEBng tr\xEAn t\u01B0\u1EDDng c\xF3 th\u1EC3
